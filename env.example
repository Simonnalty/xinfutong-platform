# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=xft
DB_PASSWORD=xft_dev_2026
DB_NAME=xinfutong_v2

# ===== 服务 =====
PORT_V2=8790
HOST=0.0.0.0

# ===== AI（留空则自动降级为模板模式，不影响其他功能） =====
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# ===== 其他 =====
PYTHON=python3
XFT_SIGN_KEY=改成你自己的随机字符串

# PDF 二维码：填写手机和接收单位可访问的站点地址
XFT_PUBLIC_BASE_URL=http://127.0.0.1:8790
# 明确启用才在空库中创建虚构演示数据；正式业务设为 0
XFT_DEMO_SEED=0

# ===== 短信验证码（阿里云「短信认证」；mode=dev 本地假发码联调，mode=aliyun 真实下发） =====
SMS_MODE=dev
# 仅 mode=aliyun 需要以下配置（需在阿里云「号码认证服务」控制台开通「短信认证」并创建 AccessKey）
SMS_ENDPOINT=dypnsapi.aliyuncs.com
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
# 签名名称/模板名称：见控制台「短信认证参数配置」页（https://dypns.console.aliyun.com/smsCertParamsConfig）
#   → 签名配置→赠送签名配置（签名名称），模板配置→赠送模板配置（模板名称）
#   已确认可用：签名「恒创联众」+ 模板「登录/注册模板」（Code 100001，正文含 ${code}/${min} 占位符）
SMS_SIGN_NAME=恒创联众
SMS_TEMPLATE_CODE=100001
SMS_SCHEME_NAME=
# 是否强制「注册前完成手机号短信核验」（正式业务建议设 1；mode=dev 时不强制）
SMS_REQUIRED=0
# 验证码有效期（秒）、核验通过后到注册的宽限期（秒）、同一号码重发最小间隔（秒）
SMS_CODE_TTL=300
SMS_VERIFY_TTL=3600
SMS_RESEND=60
